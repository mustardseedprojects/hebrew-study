  "verses": {
    "1": {
      "hebrew": "בְּרֵאשִׁית בָּרָא אֱלֹהִים אֵת הַשָּׁמַיִם וְאֵת הָאָֽרֶץ׃",
      "file": "verses/genesis-1-01.mp3"
    },
    "2": {
      "hebrew": "וְהָאָרֶץ הָיְתָה תֹהוּ וָבֹהוּ וְחֹשֶׁךְ עַל־פְּנֵי תְהוֹם וְרוּחַ אֱלֹהִים מְרַחֶפֶת עַל־פְּנֵי הַמָּֽיִם׃",
      "file": "verses/genesis-1-02.mp3"
    },
    "3": {
      "hebrew": "וַיֹּאמֶר אֱלֹהִים יְהִי אוֹר וַֽיְהִי־אֽוֹר׃",
      "file": "verses/genesis-1-03.mp3"
    },
    "4": {
      "hebrew": "וַיַּרְא אֱלֹהִים אֶת־הָאוֹר כִּי־טוֹב וַיַּבְדֵּל אֱלֹהִים בֵּין הָאוֹר וּבֵין הַחֹֽשֶׁךְ׃",
      "file": "verses/genesis-1-04.mp3"
    },
    "5": {
      "hebrew": "וַיִּקְרָא אֱלֹהִים ׀ לָאוֹר יוֹם וְלַחֹשֶׁךְ קָרָא לָיְלָה וַֽיְהִי־עֶרֶב וַֽיְהִי־בֹקֶר יוֹם אֶחָֽד׃ {פ}",
      "file": "verses/genesis-1-05.mp3"
    },
    "6": {
      "hebrew": "וַיֹּאמֶר אֱלֹהִים יְהִי רָקִיעַ בְּתוֹךְ הַמָּיִם וִיהִי מַבְדִּיל בֵּין מַיִם לָמָֽיִם׃",
      "file": "verses/genesis-1-06.mp3"
    },
    "7": {
      "hebrew": "וַיַּעַשׂ אֱלֹהִים אֶת־הָרָקִיעַ וַיַּבְדֵּל בֵּין הַמַּיִם אֲשֶׁר מִתַּחַת לָרָקִיעַ וּבֵין הַמַּיִם אֲשֶׁר מֵעַל לָרָקִיעַ וַֽיְהִי־כֵֽן׃",
      "file": "verses/genesis-1-07.mp3"
    },
    "8": {
      "hebrew": "וַיִּקְרָא אֱלֹהִים לָֽרָקִיעַ שָׁמָיִם וַֽיְהִי־עֶרֶב וַֽיְהִי־בֹקֶר יוֹם שֵׁנִֽי׃ {פ}",
      "file": "verses/genesis-1-08.mp3"
    },
    "9": {
      "hebrew": "וַיֹּאמֶר אֱלֹהִים יִקָּווּ הַמַּיִם מִתַּחַת הַשָּׁמַיִם אֶל־מָקוֹם אֶחָד וְתֵרָאֶה הַיַּבָּשָׁה וַֽיְהִי־כֵֽן׃",
      "file": "verses/genesis-1-09.mp3"
    },
    "10": {
      "hebrew": "וַיִּקְרָא אֱלֹהִים ׀ לַיַּבָּשָׁה אֶרֶץ וּלְמִקְוֵה הַמַּיִם קָרָא יַמִּים וַיַּרְא אֱלֹהִים כִּי־טֽוֹב׃",
      "file": "verses/genesis-1-10.mp3"
    },
    "11": {
      "hebrew": "וַיֹּאמֶר אֱלֹהִים תַּֽדְשֵׁא הָאָרֶץ דֶּשֶׁא עֵשֶׂב מַזְרִיעַ זֶרַע עֵץ פְּרִי עֹשֶׂה פְּרִי לְמִינוֹ אֲשֶׁר זַרְעוֹ־בוֹ עַל־הָאָרֶץ וַֽיְהִי־כֵֽן׃",
      "file": "verses/genesis-1-11.mp3"
    },
    "12": {
      "hebrew": "וַתּוֹצֵא הָאָרֶץ דֶּשֶׁא עֵשֶׂב מַזְרִיעַ זֶרַע לְמִינֵהוּ וְעֵץ עֹֽשֶׂה־פְּרִי אֲשֶׁר זַרְעוֹ־בוֹ לְמִינֵהוּ וַיַּרְא אֱלֹהִים כִּי־טֽוֹב׃",
      "file": "verses/genesis-1-12.mp3"
    },
    "13": {
      "hebrew": "וַֽיְהִי־עֶרֶב וַֽיְהִי־בֹקֶר יוֹם שְׁלִישִֽׁי׃ {פ}",
      "file": "verses/genesis-1-13.mp3"
    },
    "14": {
      "hebrew": "וַיֹּאמֶר אֱלֹהִים יְהִי מְאֹרֹת בִּרְקִיעַ הַשָּׁמַיִם לְהַבְדִּיל בֵּין הַיּוֹם וּבֵין הַלָּיְלָה וְהָיוּ לְאֹתֹת וּלְמוֹעֲדִים וּלְיָמִים וְשָׁנִֽים׃",
      "file": "verses/genesis-1-14.mp3"
    },
    "15": {
      "hebrew": "וְהָיוּ לִמְאוֹרֹת בִּרְקִיעַ הַשָּׁמַיִם לְהָאִיר עַל־הָאָרֶץ וַֽיְהִי־כֵֽן׃",
      "file": "verses/genesis-1-15.mp3"
    },
    "16": {
      "hebrew": "וַיַּעַשׂ אֱלֹהִים אֶת־שְׁנֵי הַמְּאֹרֹת הַגְּדֹלִים אֶת־הַמָּאוֹר הַגָּדֹל לְמֶמְשֶׁלֶת הַיּוֹם וְאֶת־הַמָּאוֹר הַקָּטֹן לְמֶמְשֶׁלֶת הַלַּיְלָה וְאֵת הַכּוֹכָבִֽים׃",
      "file": "verses/genesis-1-16.mp3"
    },
    "17": {
      "hebrew": "וַיִּתֵּן אֹתָם אֱלֹהִים בִּרְקִיעַ הַשָּׁמָיִם לְהָאִיר עַל־הָאָֽרֶץ׃",
      "file": "verses/genesis-1-17.mp3"
    },
    "18": {
      "hebrew": "וְלִמְשֹׁל בַּיּוֹם וּבַלַּיְלָה וּֽלְהַבְדִּיל בֵּין הָאוֹר וּבֵין הַחֹשֶׁךְ וַיַּרְא אֱלֹהִים כִּי־טֽוֹב׃",
      "file": "verses/genesis-1-18.mp3"
    },
    "19": {
      "hebrew": "וַֽיְהִי־עֶרֶב וַֽיְהִי־בֹקֶר יוֹם רְבִיעִֽי׃ {פ}",
      "file": "verses/genesis-1-19.mp3"
    },
    "20": {
      "hebrew": "וַיֹּאמֶר אֱלֹהִים יִשְׁרְצוּ הַמַּיִם שֶׁרֶץ נֶפֶשׁ חַיָּה וְעוֹף יְעוֹפֵף עַל־הָאָרֶץ עַל־פְּנֵי רְקִיעַ הַשָּׁמָֽיִם׃",
      "file": "verses/genesis-1-20.mp3"
    },
    "21": {
      "hebrew": "וַיִּבְרָא אֱלֹהִים אֶת־הַתַּנִּינִם הַגְּדֹלִים וְאֵת כׇּל־נֶפֶשׁ הַֽחַיָּה ׀ הָֽרֹמֶשֶׂת אֲשֶׁר שָׁרְצוּ הַמַּיִם לְמִֽינֵהֶם וְאֵת כׇּל־עוֹף כָּנָף לְמִינֵהוּ וַיַּרְא אֱלֹהִים כִּי־טֽוֹב׃",
      "file": "verses/genesis-1-21.mp3"
    },
    "22": {
      "hebrew": "וַיְבָרֶךְ אֹתָם אֱלֹהִים לֵאמֹר פְּרוּ וּרְבוּ וּמִלְאוּ אֶת־הַמַּיִם בַּיַּמִּים וְהָעוֹף יִרֶב בָּאָֽרֶץ׃",
      "file": "verses/genesis-1-22.mp3"
    },
    "23": {
      "hebrew": "וַֽיְהִי־עֶרֶב וַֽיְהִי־בֹקֶר יוֹם חֲמִישִֽׁי׃ {פ}",
